# Copy to `.env` (optional) or export these variables in your shell.
# The app reads them via os.environ — no dotenv dependency required.
# Leave empty for defaults. NEVER commit a real `.env` with secrets.
#
# Where to get values:
# - ANTIDETECT_CHROMIUM_PATH / CHROME_PATH: full path to your Chrome/Chromium/
#   Brave/Edge binary. Only needed if auto-discovery fails.
#   macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
# - ANTIDETECT_DATA_DIR: where the SQLite DB + Chromium profiles + logs live.
#   Default: ./data (dev checkout) or OS user-data dir (frozen app).
# - ANTIDETECT_PROXY_SOURCES: JSON list of proxy-list URLs (http/https only).

ANTIDETECT_DATA_DIR=
ANTIDETECT_CHROMIUM_PATH=
CHROME_PATH=
ANTIDETECT_LOGS_DIR=
ANTIDETECT_DISABLE_STEALTH=
ANTIDETECT_NO_SPLASH=
ANTIDETECT_NO_SANDBOX=
ANTIDETECT_PROXY_WORKERS=
ANTIDETECT_PROXY_TIMEOUT=
ANTIDETECT_PROXY_MAX_FAILURES=
ANTIDETECT_PROXY_DEAD_POLICY=
ANTIDETECT_PROXY_STALE_MINUTES=
ANTIDETECT_PROXY_SOURCES=
ANTIDETECT_STEALTH_TRACE=
