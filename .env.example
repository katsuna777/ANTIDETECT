# Copy to `.env` (optional) or export these variables in your shell.
# The app reads them via os.environ — no dotenv dependency required.
# Leave empty for defaults. NEVER commit a real `.env` with secrets.
#
# ANTIDETECT_CHROMIUM_PATH / CHROME_PATH: full path to your Chrome/Chromium/Brave/Edge
#   binary. Only needed if auto-discovery fails.
#   macOS:   /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
# ANTIDETECT_DATA_DIR: where the SQLite DB, browser profiles and logs live.
#   Default: ./data (dev checkout) or the OS user-data dir (installed app).
# ANTIDETECT_PROXY_SOURCES: JSON list of proxy-list URLs (http/https only).

ANTIDETECT_DATA_DIR=
ANTIDETECT_CHROMIUM_PATH=
CHROME_PATH=
ANTIDETECT_LOGS_DIR=
ANTIDETECT_PROXY_SOURCES=
ANTIDETECT_PROXY_WORKERS=
ANTIDETECT_PROXY_TIMEOUT=
ANTIDETECT_PROXY_MAX_FAILURES=
ANTIDETECT_PROXY_DEAD_POLICY=

# Diagnostics / experiments
ANTIDETECT_DISABLE_STEALTH=
ANTIDETECT_NO_SANDBOX=
ANTIDETECT_STEALTH_TRACE=
ANTIDETECT_MASK_FONTS=
